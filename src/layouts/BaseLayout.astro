---
import '../styles/dashboard.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "CYBERDUDEBIVASH Connect Hub | Cybersecurity Ecosystem Directory",
  description = 'Official CYBERDUDEBIVASH ECOSYSTEM directory for AI security, threat intelligence, identity security, tools, training, research and enterprise security services.'
} = Astro.props;

const SITE_URL = 'https://connect.cyberdudebivash.com';
const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.cyberdudebivash.com/#organization",
      "name": "CYBERDUDEBIVASH ECOSYSTEM®",
      "alternateName": "CYBERDUDEBIVASH",
      "url": "https://www.cyberdudebivash.com/",
      "logo": "https://www.cyberdudebivash.com/assets/images/logo.jpg",
      "description": description,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "29, Korai-Sukinda-Ramchandrapur Rd, Ragadi",
    "addressLocality": "Jajpur Road",
    "addressRegion": "Odisha",
    "postalCode": "755019",
    "addressCountry": "IN"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+91-8179881447",
    "contactType": "customer service",
    "email": "contact@cyberdudebivash.in"
  },
      "sameAs": [
        "https://www.linkedin.com/company/cyberdudebivash/",
        "https://x.com/CDBSENTINELAPEX",
        "https://github.com/cyberdudebivash"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://connect.cyberdudebivash.com/#website",
      "url": "https://connect.cyberdudebivash.com/",
      "name": "CYBERDUDEBIVASH Connect Hub",
      "publisher": { "@id": "https://www.cyberdudebivash.com/#organization" },
      "inLanguage": "en"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#050B14" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CYBERDUDEBIVASH Connect Hub" />
    <meta property="og:image" content="https://www.cyberdudebivash.com/assets/images/logo.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.cyberdudebivash.com/assets/images/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="bg-void text-ink antialiased">
    <slot />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -80px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>